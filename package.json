{
  "name": "kidum-plus",
  "private": true,
  "version": "0.88.60",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "dev:mobile": "npm --workspace apps/mobile run start",
    "typecheck": "tsc -b",
    "android:open": "echo Open apps/android in Android Studio",
    "compliance:sbom": "node scripts/compliance/generate-sbom.mjs",
    "compliance:sca:normalize": "node scripts/compliance/normalize-npm-audit.mjs",
    "compliance:ci-integrity": "node scripts/compliance/check-ci-integrity.mjs",
    "compliance:provenance": "node scripts/compliance/generate-release-provenance.mjs",
    "compliance:environment": "node scripts/compliance/generate-environment-evidence.mjs"
  }
}
